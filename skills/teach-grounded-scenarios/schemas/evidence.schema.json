{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reverse/evidence.schema.json",
  "title": "근거 레코드",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "subject_domains", "basis", "consensus", "claim", "source_ids", "reason", "must_keep"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]{3}$"
    },
    "status": {
      "enum": ["VERIFIED", "DERIVED", "SCENARIO", "UNKNOWN"]
    },
    "subject_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["HISTORY", "SCIENCE", "SOCIAL_STUDIES", "GEOGRAPHY", "MATHEMATICS", "LANGUAGE_LITERATURE", "INTERDISCIPLINARY"]
      },
      "uniqueItems": true
    },
    "basis": {
      "enum": ["DOCUMENTED_EVENT", "PRIMARY_SOURCE", "SCIENTIFIC_EVIDENCE", "MATHEMATICAL_PROOF", "LEGAL_TEXT", "STATISTICAL_DATA", "LITERARY_TEXT", "SCENARIO_CONSTRAINT", "MULTI_DOMAIN", "UNRESOLVED"]
    },
    "consensus": {
      "enum": ["ESTABLISHED", "STRONG", "EMERGING", "CONTESTED", "NOT_APPLICABLE", "UNKNOWN"]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "derived_from": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "default": []
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "must_keep": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "VERIFIED" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "source_ids": { "type": "array", "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "DERIVED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["derived_from", "limitations"],
        "properties": {
          "derived_from": { "type": "array", "minItems": 2 },
          "limitations": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
