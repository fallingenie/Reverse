{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reverse/lesson-turn.schema.json",
  "title": "개발·교사용 결합 수업 턴 fixture",
  "description": "개발 회귀검사와 접근이 분리된 교사용 흐름에서만 쓰는 결합 fixture다. 학생 런타임, 학생용 Skill 배포물, 학생용 Knowledge 또는 학생 응답에는 사용하지 않는다. 학생 경로는 student-lesson-turn.schema.json을 사용한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["turn", "student_view", "evidence_ids", "memory_delta"],
  "properties": {
    "turn": { "type": "integer", "minimum": 1 },
    "student_view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene", "clues", "thinking_question", "choices", "custom_input_allowed"],
      "properties": {
        "scene": { "type": "string", "minLength": 1 },
        "clues": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "thinking_question": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "custom_input_allowed": { "const": true }
      }
    },
    "teacher_view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_rationale": { "type": "string" },
        "misconception_watch": { "type": "string" },
        "assessment_note": { "type": "string" }
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "memory_delta": {
      "$ref": "https://example.org/reverse/memory-delta.schema.json"
    }
  }
}
