{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reverse/session.schema.json",
  "title": "근거 기반 수업 세션",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "revision",
    "profile",
    "gate",
    "lesson",
    "sources",
    "evidence",
    "memory"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "revision": { "type": "integer", "minimum": 0 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "subject", "unit", "interests"],
      "properties": {
        "grade": {
          "enum": ["초3", "초4", "초5", "초6", "중1", "중2", "중3", "고1", "고2"]
        },
        "subject": { "type": "string", "minLength": 1 },
        "unit": { "type": "string" },
        "interests": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "start_token", "start_confirmed"],
      "properties": {
        "state": {
          "enum": [
            "COLLECT_PROFILE",
            "OFFER_SCENARIOS",
            "CONFIRM_SCENARIO",
            "WAIT_FOR_START",
            "RUN_LESSON",
            "DEBRIEF"
          ]
        },
        "start_token": { "const": "[시작]" },
        "start_confirmed": { "type": "boolean" }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "title", "divergence", "historical_cutoff", "objectives", "sensitivity"],
      "properties": {
        "scenario_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "divergence": { "type": "string", "minLength": 1 },
        "historical_cutoff": { "type": "string", "format": "date" },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sensitivity": { "enum": ["LOW", "MEDIUM", "HIGH"] }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "institution", "url", "accessed_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^SRC-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "institution": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "accessed_at": { "type": "string", "format": "date" }
        }
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "https://example.org/reverse/evidence.schema.json" }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon",
        "current_state",
        "negative_facts",
        "corrections",
        "open_threads",
        "episode_archive",
        "conflicts",
        "discarded_detail_summary",
        "compaction"
      ],
      "properties": {
        "canon": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryItem" }
        },
        "current_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["time", "place", "role", "constraints"],
          "properties": {
            "time": { "type": "string", "minLength": 1 },
            "place": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "constraints": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "negative_facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryItem" }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "replaces", "text", "reason", "must_keep"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "replaces": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "must_keep": { "const": true }
            }
          }
        },
        "open_threads": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryItem" }
        },
        "episode_archive": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "turn", "student_choice", "result", "evidence_ids", "must_keep"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "turn": { "type": "integer", "minimum": 1 },
              "student_choice": { "type": "string", "minLength": 1 },
              "result": { "type": "string", "minLength": 1 },
              "detail": { "type": "string" },
              "evidence_ids": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              },
              "must_keep": { "type": "boolean" }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "discarded_detail_summary": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence", "source_revision", "source_sha256"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 0 },
            "source_revision": { "type": "integer", "minimum": 0 },
            "source_sha256": {
              "type": "string",
              "pattern": "^$|^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "memoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "must_keep"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "must_keep": { "type": "boolean" }
      }
    }
  }
}
