{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reverse/session.schema.json",
  "title": "근거 기반 수업 세션",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "revision",
    "profile",
    "gate",
    "research",
    "lesson",
    "sources",
    "evidence",
    "memory"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "session_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "revision": { "type": "integer", "minimum": 0 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grade", "subject", "unit", "interests"],
      "properties": {
        "school_level": {
          "description": "새 세션은 학교급을 학년과 별도로 수집한다. 이 필드가 없는 기존 1.0.0 세션은 호환 목적으로 허용한다.",
          "enum": ["초등학교", "중학교", "고등학교", null]
        },
        "grade": {
          "enum": ["초3", "초4", "초5", "초6", "중1", "중2", "중3", "고1", "고2", null]
        },
        "subject": {
          "anyOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "unit": { "type": ["string", "null"] },
        "interests": {
          "anyOf": [
            {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            { "type": "null" }
          ]
        },
        "interest_source": {
          "description": "새 세션에서 관심이 학생의 직접 선택인지, 확인된 단원에서 자동 설정됐는지 구분한다. 이 필드가 없는 기존 1.0.0 세션은 호환 목적으로 허용한다.",
          "enum": ["STUDENT_EXPLICIT", "UNIT_INFERRED", "TEACHER_PRESET", "NONE", null]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "interest_source": { "const": "UNIT_INFERRED" } },
            "required": ["interest_source"]
          },
          "then": {
            "properties": {
              "unit": { "type": "string", "minLength": 1 },
              "interests": { "type": "array", "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "school_level": { "const": "초등학교" } },
            "required": ["school_level"]
          },
          "then": {
            "properties": {
              "grade": { "enum": ["초3", "초4", "초5", "초6", null] }
            }
          }
        },
        {
          "if": {
            "properties": { "school_level": { "const": "중학교" } },
            "required": ["school_level"]
          },
          "then": {
            "properties": {
              "grade": { "enum": ["중1", "중2", "중3", null] }
            }
          }
        },
        {
          "if": {
            "properties": { "school_level": { "const": "고등학교" } },
            "required": ["school_level"]
          },
          "then": {
            "properties": {
              "grade": { "enum": ["고1", "고2", null] }
            }
          }
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "start_token",
        "start_confirmed",
        "start_armed_revision",
        "start_consumed_revision"
      ],
      "properties": {
        "state": {
          "enum": [
            "COLLECT_PROFILE",
            "PLAN_RESEARCH",
            "RESEARCH",
            "OFFER_SCENARIOS",
            "CONFIRM_SCENARIO",
            "WAIT_FOR_START",
            "RUN_LESSON",
            "DEBRIEF"
          ]
        },
        "start_token": { "const": "[시작]" },
        "start_confirmed": { "type": "boolean" },
        "start_armed_revision": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "시나리오 선택 확인 뒤 새 시작 요청을 발급한 세션 revision"
        },
        "start_consumed_revision": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "별도 메시지 전체의 정확한 시작 토큰을 한 번 소비한 세션 revision"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "start_confirmed": { "const": true } },
            "required": ["start_confirmed"]
          },
          "then": {
            "properties": {
              "state": { "enum": ["RUN_LESSON", "DEBRIEF"] },
              "start_armed_revision": { "type": "integer" },
              "start_consumed_revision": { "type": "integer" }
            }
          }
        },
        {
          "if": {
            "properties": { "start_confirmed": { "const": false } },
            "required": ["start_confirmed"]
          },
          "then": {
            "properties": {
              "state": {
                "not": { "enum": ["RUN_LESSON", "DEBRIEF"] }
              },
              "start_consumed_revision": { "type": "null" }
            }
          }
        }
      ]
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "readiness_checked", "gaps"],
      "properties": {
        "plan": { "$ref": "https://example.org/reverse/research-plan.schema.json" },
        "readiness_checked": { "type": "boolean" },
        "gaps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "title", "subject_domains", "lesson_mode", "premise", "objectives", "sensitivity", "research_id"],
      "properties": {
        "scenario_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subject_domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["HISTORY", "SCIENCE", "SOCIAL_STUDIES", "GEOGRAPHY", "MATHEMATICS", "LANGUAGE_LITERATURE", "INTERDISCIPLINARY"]
          },
          "uniqueItems": true
        },
        "lesson_mode": {
          "enum": ["HISTORICAL_ROLE", "COUNTERFACTUAL", "SCIENCE_INQUIRY", "EXPERIMENT_DESIGN", "SOCIAL_DECISION", "GEOGRAPHIC_FIELDWORK", "MATHEMATICAL_PROBLEM", "LITERARY_PERSPECTIVE", "INTERDISCIPLINARY_PROJECT"]
        },
        "premise": { "type": "string", "minLength": 1 },
        "research_id": { "type": "string", "pattern": "^RES-[A-Z0-9-]+$" },
        "historical_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cutoff", "divergence"],
          "properties": {
            "cutoff": { "type": "string", "format": "date" },
            "divergence": { "type": "string", "minLength": 1 }
          }
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sensitivity": { "enum": ["LOW", "MEDIUM", "HIGH"] }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "https://example.org/reverse/source-record.schema.json" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "https://example.org/reverse/evidence.schema.json" }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon",
        "current_state",
        "negative_facts",
        "corrections",
        "open_threads",
        "episode_archive",
        "conflicts",
        "discarded_detail_summary",
        "compaction"
      ],
      "properties": {
        "canon": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryItem" }
        },
        "current_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["time", "place", "role", "constraints"],
          "properties": {
            "time": { "type": "string", "minLength": 1 },
            "place": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "constraints": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "negative_facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryItem" }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "severity", "replaces", "text", "reason", "evidence_ids", "affected_ids", "last_valid_checkpoint", "decision", "user_options", "must_keep"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "severity": { "enum": ["LOCAL_PATCH", "TRACK_REBASE", "RESTART_RECOMMENDED"] },
              "replaces": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "text": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "affected_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "last_valid_checkpoint": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "null" }
                ]
              },
              "decision": { "enum": ["APPLIED", "USER_DECISION_PENDING", "RESTART_ACCEPTED", "RESTART_DECLINED", "ALTERNATE_FICTION"] },
              "user_options": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "must_keep": { "const": true }
            }
          }
        },
        "open_threads": {
          "type": "array",
          "items": { "$ref": "#/$defs/memoryItem" }
        },
        "episode_archive": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "turn", "student_choice", "result", "evidence_ids", "must_keep"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "turn": { "type": "integer", "minimum": 1 },
              "student_choice": { "type": "string", "minLength": 1 },
              "result": { "type": "string", "minLength": 1 },
              "detail": { "type": "string" },
              "evidence_ids": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              },
              "must_keep": { "type": "boolean" }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "discarded_detail_summary": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "compaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence", "source_revision", "source_sha256"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 0 },
            "source_revision": { "type": "integer", "minimum": 0 },
            "source_sha256": {
              "type": "string",
              "pattern": "^$|^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gate": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "PLAN_RESEARCH",
                  "RESEARCH",
                  "OFFER_SCENARIOS",
                  "CONFIRM_SCENARIO",
                  "WAIT_FOR_START",
                  "RUN_LESSON",
                  "DEBRIEF"
                ]
              }
            },
            "required": ["state"]
          }
        },
        "required": ["gate"]
      },
      "then": {
        "properties": {
          "profile": {
            "type": "object",
            "properties": {
              "school_level": {
                "enum": ["초등학교", "중학교", "고등학교"]
              },
              "grade": {
                "enum": ["초3", "초4", "초5", "초6", "중1", "중2", "중3", "고1", "고2"]
              },
              "subject": { "type": "string", "minLength": 1 },
              "unit": { "type": "string" },
              "interests": { "type": "array" },
              "interest_source": {
                "enum": ["STUDENT_EXPLICIT", "UNIT_INFERRED", "TEACHER_PRESET", "NONE"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "memoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "must_keep"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "must_keep": { "type": "boolean" }
      }
    }
  }
}
