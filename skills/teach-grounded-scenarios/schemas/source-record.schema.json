{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reverse/source-record.schema.json",
  "title": "검증된 출처 레코드",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "creator",
    "institution",
    "source_class",
    "subject_domains",
    "url",
    "published_at",
    "accessed_at",
    "opened",
    "direct_support",
    "limitations",
    "freshness"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^SRC-[0-9]{2,4}$" },
    "title": { "type": "string", "minLength": 1 },
    "creator": { "type": "string", "minLength": 1 },
    "institution": { "type": "string", "minLength": 1 },
    "source_class": {
      "enum": ["PRIMARY_SOURCE", "OFFICIAL_RECORD", "PEER_REVIEWED", "SYSTEMATIC_REVIEW", "DATASET", "LEGAL_TEXT", "LITERARY_TEXT", "REFERENCE_WORK", "CURRICULUM_RESOURCE"]
    },
    "subject_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["HISTORY", "SCIENCE", "SOCIAL_STUDIES", "GEOGRAPHY", "MATHEMATICS", "LANGUAGE_LITERATURE", "INTERDISCIPLINARY"]
      },
      "uniqueItems": true
    },
    "url": { "type": "string", "format": "uri" },
    "published_at": {
      "anyOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "accessed_at": { "type": "string", "format": "date" },
    "opened": { "const": true },
    "direct_support": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "freshness": {
      "enum": ["STABLE", "CHECKED_THIS_SESSION", "TIME_SENSITIVE", "UNKNOWN"]
    }
  }
}
