{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reverse/memory-delta.schema.json",
  "title": "턴별 기억 델타",
  "description": "구조 계약만 정의한다. revision 관계, 참조 존재 여부, 보호 대상 승인과 JSON Pointer 우회는 scripts/validate-memory-delta.mjs가 검사한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_revision", "next_revision", "add", "correct", "resolve"],
  "properties": {
    "base_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "next_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "add": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value", "reason"],
        "properties": {
          "path": {
            "enum": [
              "/memory/current_state/constraints/-",
              "/memory/open_threads/-",
              "/memory/episode_archive/-",
              "/memory/conflicts/-"
            ]
          },
          "value": {},
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "correct": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/correctionProposal" }
    },
    "resolve": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^OPEN-[A-Z0-9-]{3,75}$"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "recordId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,80}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": ["EVIDENCE", "SOURCE", "PDF_CHUNK", "TURN", "USER_DECISION", "SYSTEM_RULE"]
        },
        "ref": { "$ref": "#/$defs/recordId" },
        "content_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "enum": ["EVIDENCE", "USER_DECISION"] }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "content_sha256": false
            }
          }
        }
      ]
    },
    "impactScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "timeline",
        "causality",
        "student_choices",
        "current_state",
        "learning_objective"
      ],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "timeline": { "type": "boolean" },
        "causality": { "type": "boolean" },
        "student_choices": { "type": "boolean" },
        "current_state": { "type": "boolean" },
        "learning_objective": { "type": "boolean" }
      }
    },
    "correctionProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correction_id",
        "target_id",
        "replacement",
        "reason",
        "severity",
        "evidence_ids",
        "provenance",
        "affected_ids",
        "impact_scope",
        "last_valid_checkpoint",
        "decision",
        "user_options"
      ],
      "properties": {
        "correction_id": {
          "type": "string",
          "pattern": "^COR-[A-Z0-9-]{4,76}$"
        },
        "target_id": { "$ref": "#/$defs/recordId" },
        "replacement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "severity": {
          "enum": ["LOCAL_PATCH", "TRACK_REBASE", "RESTART_RECOMMENDED"]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/recordId" },
          "uniqueItems": true
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/provenance" }
        },
        "affected_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/recordId" },
          "uniqueItems": true
        },
        "impact_scope": { "$ref": "#/$defs/impactScope" },
        "last_valid_checkpoint": {
          "anyOf": [
            { "$ref": "#/$defs/recordId" },
            { "type": "null" }
          ]
        },
        "decision": {
          "enum": [
            "APPLIED",
            "USER_DECISION_PENDING",
            "RESTART_ACCEPTED",
            "RESTART_DECLINED",
            "ALTERNATE_FICTION"
          ]
        },
        "user_options": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "severity": { "const": "LOCAL_PATCH" } },
            "required": ["severity"]
          },
          "then": {
            "properties": {
              "decision": { "enum": ["APPLIED", "USER_DECISION_PENDING"] }
            }
          }
        },
        {
          "if": {
            "properties": { "severity": { "const": "TRACK_REBASE" } },
            "required": ["severity"]
          },
          "then": {
            "properties": {
              "last_valid_checkpoint": { "$ref": "#/$defs/recordId" },
              "decision": { "enum": ["APPLIED", "USER_DECISION_PENDING", "ALTERNATE_FICTION"] },
              "user_options": { "type": "array", "minItems": 2 }
            }
          }
        },
        {
          "if": {
            "properties": { "severity": { "const": "RESTART_RECOMMENDED" } },
            "required": ["severity"]
          },
          "then": {
            "properties": {
              "decision": {
                "enum": ["USER_DECISION_PENDING", "RESTART_ACCEPTED", "RESTART_DECLINED", "ALTERNATE_FICTION"]
              },
              "user_options": { "type": "array", "minItems": 2 }
            }
          }
        }
      ]
    }
  }
}
