{
  "contract_version": "reverse.start-intent.v1",
  "description": "직전 시작 동의 요청에 대한 메시지 전체의 의미가 명백한 시작 동의인지 추론하는 일반 시작 게이트 회귀 계약이다. lexical case는 의미 추론의 seed이며 닫힌 allowlist가 아니다. NEGATIVE_FALLBACK_START는 이 계약과 별도 사건으로 유지한다.",
  "decision_order": [
    "순서형 일회성 세션 상태와 직전 시작 동의 요청을 먼저 확인",
    "Unicode NFKC는 동등 표현 처리에만 사용",
    "인용·부정·취소·과거형·조건부·메타질문·공격·혼합 지시 하드 거부",
    "메시지 전체의 의미가 지금 시작하자는 명백한 동의인지 추론",
    "결정론적 reference oracle은 회귀 seed만 다루며 의미 경계 전체를 대표하지 않음"
  ],
  "semantic_inference_contract": {
    "entire_message_clear_start_consent": true,
    "negated_or_cancelled": false,
    "quoted_or_meta": false,
    "conditional": false,
    "mixed_instruction_or_attack": false,
    "rule": "비공개 추론 원문이나 rationale은 저장하지 않고 경계 판정 boolean만 전달한다."
  },
  "state_requirements": {
    "p0": "SAFE",
    "gate.state": "WAIT_FOR_START",
    "gate.start_token": "[시작]",
    "gate.start_confirmed": false,
    "gate.start_armed_revision": "현재 revision과 같은 정수",
    "gate.start_consumed_revision": null,
    "research_complete": true,
    "five_scenarios_offered": true,
    "scenario_selected": true,
    "start_requested_previous_turn": true,
    "fallback_started": false
  },
  "student_output_contract": {
    "forbidden_terms": [
      "Identifying token issue",
      "NEGATIVE_FALLBACK_START",
      "ORDERED_START",
      "WAIT_FOR_START",
      "chain-of-thought"
    ],
    "rule": "내부 판정 코드, 사건명, 비공개 추론 라벨은 학생 안내에 출력하지 않는다."
  },
  "valid_state": {
    "revision": 7,
    "p0": "SAFE",
    "terminated": false,
    "fallback_started": false,
    "research_complete": true,
    "five_scenarios_offered": true,
    "scenario_selected": true,
    "start_requested_previous_turn": true,
    "gate": {
      "state": "WAIT_FOR_START",
      "start_token": "[시작]",
      "start_confirmed": false,
      "start_armed_revision": 7,
      "start_consumed_revision": null
    }
  },
  "cases": [
    {
      "id": "canonical-bracketed-korean",
      "input": "[시작]",
      "expected": { "accepted": true, "reason": "PERMITTED_DECORATION" }
    },
