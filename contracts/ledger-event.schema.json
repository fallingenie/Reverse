{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reverse/ledger-event.schema.json",
  "title": "Reverse 추가 전용 원장 이벤트",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "event_id", "occurred_at", "event_type", "actor", "profile_id", "payload", "previous_hash", "event_hash"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "pattern": "^EVT-[A-Z0-9-]+$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "event_type": { "enum": ["SESSION_CREATED", "CANON_PROPOSED", "CANON_COMMITTED", "CANON_SUPERSEDED", "UNKNOWN_LOCKED", "CORRECTION_RECORDED", "CONTEXT_EXPORTED", "PDF_REFERENCE_ADDED"] },
    "actor": { "enum": ["HOST", "TEACHER", "STUDENT", "MODEL", "MIGRATION"] },
    "profile_id": { "enum": ["CHATGPT_FREE", "COPILOT_M365", "WINDOWS_STANDALONE"] },
    "payload": { "type": "object" },
    "previous_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "event_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
