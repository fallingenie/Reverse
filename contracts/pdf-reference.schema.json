{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reverse/pdf-reference.schema.json",
  "title": "Reverse PDF 참조 문서",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "source_name", "sha256", "byte_size", "page_count", "status", "rights_basis", "content_trust", "extraction", "chunks", "created_at"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "document_id": { "type": "string", "pattern": "^PDF-[A-F0-9]{12}$" },
    "source_name": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "byte_size": { "type": "integer", "minimum": 1, "maximum": 104857600 },
    "page_count": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["ACTIVE", "NEEDS_REVIEW", "OCR_REQUIRED", "REJECTED"] },
    "rights_basis": { "enum": ["OWNED", "LICENSED", "EDUCATIONAL_USE_REVIEWED", "UNKNOWN"] },
    "content_trust": { "const": "UNTRUSTED_REFERENCE_DATA" },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engine_version", "encrypted", "active_content_detected", "warnings"],
      "properties": {
        "engine": { "enum": ["pypdf", "pdfplumber"] },
        "engine_version": { "type": "string", "minLength": 1 },
        "encrypted": { "type": "boolean" },
        "active_content_detected": { "type": "boolean" },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "chunks": { "type": "array", "items": { "$ref": "https://example.org/reverse/reference-chunk.schema.json" } },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
